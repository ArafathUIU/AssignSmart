# ==========================================================================
# AssignSmart — Environment Variables
# Copy this file to `.env` (root, for reference only) and set real values.
# The backend reads these as environment variables that override
# `backend/AssignSmart.Api/appsettings.json`.
# The frontend reads `NEXT_PUBLIC_*` variables from `frontend/.env.local`.
# Never commit real secrets.
# ==========================================================================

# --------------------------------------------------------------------------
# Backend — PostgreSQL connection string
# --------------------------------------------------------------------------
# This sample matches the docker-compose setup (container exposed on host
# port 5433 to avoid clashing with an existing local PostgreSQL on 5432).
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=assignsmart;Username=assignsmart;Password=assignsmart

# --------------------------------------------------------------------------
# Backend — JWT settings (REPLACE with a secure random key in production)
# --------------------------------------------------------------------------
Jwt__Key=REPLACE_WITH_A_LONG_SECURE_RANDOM_KEY_AT_LEAST_32_CHARS
Jwt__Issuer=AssignSmart
Jwt__Audience=AssignSmart
Jwt__ExpiresInMinutes=120

# --------------------------------------------------------------------------
# Backend — CORS (comma-separated origins via appsettings, or use indexes)
# --------------------------------------------------------------------------
# Cors__AllowedOrigins__0=http://localhost:3000

# --------------------------------------------------------------------------
# Frontend — API base URL (used by the browser; put this in frontend/.env.local)
# --------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://localhost:7030
